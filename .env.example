# GitHub Security Alerts Exporter - environment file
#
#   Docker Compose : copy to ".env" next to docker-compose.yml
#   systemd        : copy to /etc/github-exporter/github-exporter.env
#
# One KEY=value per line. No "export", no shell expansion. Wrap values that
# contain spaces in double quotes. Never commit the real file.

# ---------------------------------------------------------------------------
# GitHub organization
# ---------------------------------------------------------------------------
GITHUB_ORG=your-organization

# ---------------------------------------------------------------------------
# Authentication - GitHub App (recommended)
# ---------------------------------------------------------------------------
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/github-exporter/github-app.pem

# ---------------------------------------------------------------------------
# Authentication - Personal Access Token (alternative)
# Set GITHUB_AUTH_MODE=pat and remove the three GITHUB_APP_* lines above.
# ---------------------------------------------------------------------------
# GITHUB_AUTH_MODE=pat
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Refresh
# ---------------------------------------------------------------------------
# When to query GitHub (5-field cron, UTC). Default: once a day at midnight.
# CRON_SCHEDULE="0 0 * * *"

# Which alert types to collect: dependabot, code_scanning, secret_scanning.
# ENABLED_SCANNERS=dependabot,code_scanning,secret_scanning

# Also count fixed / dismissed / resolved alerts (false = open alerts only).
# INCLUDE_CLOSED_ALERTS=true

# Scan archived repositories.
# INCLUDE_ARCHIVED_REPOS=false

# Restrict the repositories by name (regular expressions).
# REPO_INCLUDE_REGEX=
# REPO_EXCLUDE_REGEX=

# Maximum parallel GitHub API requests.
# CONCURRENCY=5

# ---------------------------------------------------------------------------
# HTTP endpoint
# ---------------------------------------------------------------------------
LISTEN_PORT=8080

# Serve /metrics from memory for this long, so several Prometheus servers
# scraping a few seconds apart cost one rendering. Go duration (90s, 2m). 0 = off.
METRICS_CACHE_TTL=2m

# Enables HTTPS and basic authentication. Leave unset for plain HTTP.
WEB_CONFIG_FILE=/etc/github-exporter/web-config.yml

# Docker Compose only: host address to publish the port on.
# 0.0.0.0 = all interfaces, 127.0.0.1 = local only.
BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------
# Logging / GitHub Enterprise Server
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# GITHUB_API_URL=https://github.example.com/api/v3
